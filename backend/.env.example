[TEMPLATE]
# Server
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# CORS: comma-separated list of allowed origins (Cloudflare Pages URL goes here in Phase 2)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=180000

# Generation defaults (overridable per request)
GEN_TEMPERATURE=0.7
GEN_MAX_TOKENS=700

# SQLite (created automatically; node:sqlite requires no native build).
# Default lives in %LOCALAPPDATA%\ai-whatsapp-agent\app.db — intentionally NOT in this
# OneDrive-synced folder (cloud sync locks/corrupts SQLite files).
# Override only with a local, non-synced path:
# SQLITE_PATH=./data/app.db

# Phase 1 POC: skip real LLM calls and return a canned message (true/false)
MOCK_LLM=false

# Duplicate prevention window for identical topics (hours, no-group requests)
DUP_WINDOW_HOURS=24

# Auth — REQUIRED for login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# WhatsApp (Phase 2) — session files live under %LOCALAPPDATA%\ai-whatsapp-agent\wwebjs_auth
# (never commit or cloud-sync them; treat them like passwords)
WA_MIN_DELAY_MS=8000
WA_SESSION_TIMEOUT_MS=90000

# Production build configuration (baked into the bundle at build time).
# Committed so Cloudflare Pages builds always target the live tunnel even if
# the Pages environment variable is missing or mistyped.
# NOTE: trycloudflare quick-tunnel URLs change whenever cloudflared restarts —
# update this file (or the Pages env var) when that happens.
VITE_API_BASE=https://ohio-efficiency-interactive-pursue.trycloudflare.com
